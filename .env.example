NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NUXT_SUPABASE_SECRET_KEY=sb_secret_your-key
NUXT_RATE_LIMIT_PEPPER=replace-with-a-long-random-secret

# Optional: only required when running Google OAuth through the local Supabase stack.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
